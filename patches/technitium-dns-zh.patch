+    function run() {
+        if (!document.body) return;
+        document.documentElement.lang = "zh-CN";
+        document.title = "DNS 服务器控制台";
+        fixSpecial();
+        patchUpdateChart();
+        patchDialogs();
+        patchChartLegend();
+        walk(document.body);
+        fixCodeLabels();
+    }
+
+    if (document.readyState === "loading") {
+        document.addEventListener("DOMContentLoaded", run);
+    } else {
