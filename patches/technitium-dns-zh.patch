@@ -0,0 +1,222 @@
+/*
+ * Technitium DNS Server - Simplified Chinese app store metadata
+ * Community localization patch for the GPLv3 project
+ * https://github.com/TechnitiumSoftware/DnsServer
+ *
+ * App names and descriptions are provided by the Technitium app store.
+ * This file translates the current store catalog. New or changed apps fall
+ * back to their original English text until this catalog is updated.
+ */
+(function () {
+    "use strict";
+
+    var APPS = {
+        "Advanced Blocking": {
+            name: "高级拦截",
+            description: "使用域名拦截列表和正则拦截列表拦截域名。支持按客户端 IP 地址或子网创建分组，为每个分组分别应用不同的拦截列表和正则拦截列表。\n\n注意！此应用独立于 DNS 服务器自带的拦截功能，DNS 服务器“设置”里的选项不会作用于这个应用。"
+        },
+        "Advanced Forwarding": {
+            name: "高级转发",
+            description: "提供高级的批量条件转发选项。支持按客户端 IP 地址或子网创建分组，为每个分组启用不同的条件转发配置。支持 AdGuard Upstreams 配置文件。\n\n注意：此应用独立于 DNS 服务器自带的“条件转发区域”功能。"
+        },
+        "Auto PTR": {
+            name: "自动 PTR",
+            description: "允许在主区域和转发区域创建 APP 记录，为 IPv4 和 IPv6 的 PTR 查询自动生成响应。"
+        },
+        "Block Page": {
+            name: "拦截提示页",
+            description: "通过内置网页服务器提供一个拦截提示页；当 DNS 服务器拦截某个网站时，可以把这个页面展示给终端用户。\n\n注意！需要先在拦截设置里把“拦截类型”设为“自定义地址”，并把当前服务器的 IP 地址配置为“自定义拦截地址”，提示页才会显示。要启用 HTTPS，请使用 PKCS #12 证书（.pfx 或 .p12）。启用 HTTPS 后，用户会看到证书错误，这是预期行为，需要用户忽略证书错误才能看到提示页。如果开启了在线证书签名，可以把本应用配置文件夹里的自签名根证书安装到所有终端系统，避免显示提示页时出现证书错误。"
+        },
+        "Default Records": {
+            name: "默认记录",
+            description: "允许为已配置的本地区域设置一条或多条默认记录。"
+        },
+        "DNS64": {
+            name: "DNS64",
+            description: "为权威解析和递归解析响应启用 DNS64 功能，供仅使用 IPv6 的客户端使用。\n\n警告！如果安装了 DNS64 应用但没有配置 NAT64，部分网站会出现连接问题。"
+        },
+        "DNS Block List (DNSBL)": {
+            name: "DNS 拦截列表（DNSBL）",
+            description: "允许在主区域和转发区域创建 APP 记录，根据配置的 DNS 拦截列表（DNSBL）返回 A 或 TXT 记录。实现基于 RFC 5782。"
+        },
+        "DNS Rebinding Protection": {
+            name: "DNS 重绑定防护",
+            description: "使用配置的私有域名和网络防御 DNS 重绑定攻击。\n\n警告！对于不是本地托管的域名，此应用会从响应中移除私有 IP 地址。"
+        },
+        "Drop Requests": {
+            name: "丢弃请求",
+            description: "丢弃命中“已拦截网络”或“已拦截问题”列表的入站 DNS 请求。"
+        },
+        "Failover": {
+            name: "故障转移",
+            description: "允许在主区域和转发区域创建 APP 记录，根据服务器健康状态返回 A、AAAA 或 CNAME 记录。支持邮件告警和 Webhook 来传递健康状态。"
+        },
+        "Filter AAAA": {
+            name: "过滤 AAAA",
+            description: "当同一域名存在 A 记录时，通过返回 NO DATA 响应来过滤 AAAA 记录。这样使用双栈（IPv4 和 IPv6）网络的客户端会优先用 IPv4 连接网站，只有网站不支持 IPv4 时才用 IPv6。"
+        },
+        "Geo Continent": {
+            name: "按洲解析",
+            description: "允许在主区域和转发区域创建 APP 记录，根据客户端所在大洲或自治系统号（ASN）返回 A、AAAA 或 CNAME 记录，使用 MaxMind GeoIP2 Country 数据库。支持 EDNS 客户端子网（ECS）。此应用需要 MaxMind GeoIP2 数据库，并附带 GeoLite2 版本供试用。\n\n要更新应用的 MaxMind GeoIP2 数据库，请从 MaxMind 下载 GeoIP2-Country.mmdb 文件并打包成 ZIP，然后用“手动更新”选项上传。应用还可以选用 MaxMind ISP/ASN 数据库，更新方法相同。"
+        },
+        "Geo Country": {
+            name: "按国家解析",
+            description: "允许在主区域和转发区域创建 APP 记录，根据客户端所在国家或自治系统号（ASN）返回 A、AAAA 或 CNAME 记录，使用 MaxMind GeoIP2 Country 数据库。支持 EDNS 客户端子网（ECS）。此应用需要 MaxMind GeoIP2 数据库，并附带 GeoLite2 版本供试用。\n\n要更新应用的 MaxMind GeoIP2 数据库，请从 MaxMind 下载 GeoIP2-Country.mmdb 文件并打包成 ZIP，然后用“手动更新”选项上传。应用还可以选用 MaxMind ISP/ASN 数据库，更新方法相同。"
+        },
+        "Geo Distance": {
+            name: "按距离解析",
+            description: "允许在主区域和转发区域创建 APP 记录，根据客户端地理位置最近的服务器返回 A、AAAA 或 CNAME 记录，使用 MaxMind GeoIP2 City 数据库。支持 EDNS 客户端子网（ECS）。此应用需要 MaxMind GeoIP2 数据库，并附带 GeoLite2 版本供试用。\n\n要更新应用的 MaxMind GeoIP2 数据库，请从 MaxMind 下载 GeoIP2-City.mmdb 文件并打包成 ZIP，然后用“手动更新”选项上传。应用还可以选用 MaxMind ISP/ASN 数据库，更新方法相同。"
+        },
+        "Log Exporter": {
+            name: "日志导出器",
+            description: "允许把查询日志导出到第三方接收端。支持导出到文件、HTTP 端点和 Syslog（UDP、TCP、TLS 和本地协议）。"
+        },
+        "NO DATA": {
+            name: "无数据（NO DATA）",
+            description: "允许在条件转发区域创建 APP 记录，对命中已配置查询类型（QTYPE）的请求返回 NO DATA 响应，阻止这些请求被转发。"
+        },
+        "NX Domain": {
+            name: "NX 域名",
+            description: "用 NXDOMAIN（域名不存在）响应拦截已配置的域名。"
+        },
+        "NX Domain Override": {
+            name: "NX 域名覆盖",
+            description: "用自定义 A/AAAA 记录响应覆盖已配置域名的 NXDOMAIN 响应。"
+        },
+        "Query Logs (MySQL)": {
+            name: "查询日志（MySQL）",
+            description: "把所有入站 DNS 请求及其响应记录到 MySQL/MariaDB 数据库，可以从 DNS 服务器 Web 控制台查询。\n\n注意！需要先创建数据库用户，并授予该用户访问数据库的全部权限。请在 MySQL root 提示符下用所需的数据库名和用户名运行以下命令：\nCREATE USER 'user'@'%' IDENTIFIED BY 'password';\nGRANT ALL PRIVILEGES ON DatabaseName.* TO 'user'@'%';\n\n数据库配置好后，编辑应用配置，更新数据库名、连接字符串，并把 enableLogging 设为 true。保存配置后，应用会自动创建所需的数据库结构并开始记录查询。"
+        },
+        "Query Logs (PostgreSQL)": {
+            name: "查询日志（PostgreSQL）",
+            description: "把所有入站 DNS 请求及其响应记录到 PostgreSQL 数据库，可以从 DNS 服务器 Web 控制台查询。\n\n注意！需要先创建数据库用户和数据库，并授予该用户访问数据库的全部权限。请在 PostgreSQL root 提示符下用所需的数据库名和用户名运行以下命令：\nCREATE USER \"user\" password 'password';\nCREATE DATABASE \"DatabaseName\" OWNER \"user\";\nGRANT ALL PRIVILEGES ON DATABASE \"DatabaseName\" TO \"user\";\n\n数据库配置好后，编辑应用配置，更新数据库名、连接字符串，并把 enableLogging 设为 true。保存配置后，应用会自动创建所需的数据库表并开始记录查询。"
+        },
+        "Query Logs (Sqlite)": {
+            name: "查询日志（SQLite）",
+            description: "把所有入站 DNS 请求及其响应记录到 SQLite 数据库，可以从 DNS 服务器 Web 控制台查询。\n\n注意！查询日志吞吐量受 SQLite 数据库文件所在磁盘的吞吐量限制。不建议在超高吞吐场景（每秒超过 2 万次请求）使用此应用。\n\n警告！把 enableVacuum 设为 true 后，应用会在删除记录后执行 VACUUM 命令，这会增加磁盘 IO，并可能让应用暂时无响应。建议只在需要时临时开启，用来压缩磁盘上的数据库文件。"
+        },
+        "Query Logs (SQL Server)": {
+            name: "查询日志（SQL Server）",
+            description: "把所有入站 DNS 请求及其响应记录到 Microsoft SQL Server 数据库，可以从 DNS 服务器 Web 控制台查询。\n\n注意！需要先创建数据库用户，编辑数据库用户属性并启用 dbcreator 服务器角色，应用才能创建和初始化数据库。数据库配置好后，编辑应用配置，更新数据库名、连接字符串，并把 enableLogging 设为 true。保存配置后，应用会自动创建所需的数据库结构并开始记录查询。"
+        },
+        "Split Horizon": {
+            name: "分离视图",
+            description: "允许在主区域和转发区域创建 APP 记录，为通过公网、私网或其他指定网络查询的客户端返回不同的 A/AAAA 记录或 CNAME 记录。\n\n支持根据客户端网络地址或配置的域名，对 A 和 AAAA 类型响应中的 IP 地址做地址转换，使用配置的 1:1 转换规则。"
+        },
+        "Weighted Round Robin": {
+            name: "加权轮询",
+            description: "允许在主区域和转发区域创建 APP 记录，使用加权轮询负载均衡返回 A、AAAA 或 CNAME 记录。"
+        },
+        "What Is My Dns": {
+            name: "我的 DNS 是什么",
+            description: "允许在主区域和转发区域创建 APP 记录，为 A、AAAA 和 TXT 查询返回用户 DNS 服务器的 IP 地址。"
+        },
+        "Wild IP": {
+            name: "通配 IP",
+            description: "允许在主区域和转发区域创建 APP 记录，为 A 和 AAAA 查询返回子域名中嵌入的 IP 地址，包括紧凑的十六进制 IPv4 标签。工作方式类似 sslip.io。"
+        },
+        "Zone Alias": {
+            name: "区域别名",
+            description: "允许为任意区域（内部或外部）配置别名，让它们都返回同一组记录。"
+        }
+    };
+
+    window.translateStoreAppInfo = function (name, description) {
+        var item = APPS[name];
+        if (!item) return { name: name, description: description };
+        return { name: item.name, description: item.description };
+    };
+
+    function escapeHtml(value) {
+        return String(value)
+            .replace(/&/g, "&amp;")
+            .replace(/</g, "&lt;")
+            .replace(/>/g, "&gt;")
+            .replace(/"/g, "&quot;")
+            .replace(/'/g, "&#39;");
+    }
+
+    function translateStoreRows() {
+        var rows = document.querySelectorAll("#tableStoreAppsBody tr");
+        for (var i = 0; i < rows.length; i++) {
+            var row = rows[i];
+            if (row.getAttribute("data-zh-store") === "1") continue;
+
+            var nameSpan = row.querySelector('span[style*="font-weight: bold"]');
+            if (!nameSpan) continue;
+
+            var originalName = nameSpan.textContent.trim();
+            var item = APPS[originalName];
+            if (!item) continue;
+
+            nameSpan.textContent = item.name;
+
+            var descDiv = row.querySelector('div[style*="margin-bottom: 10px"]');
+            if (descDiv) {
+                descDiv.innerHTML = escapeHtml(item.description).replace(/\n/g, "<br />");
+            }
+
+            row.setAttribute("data-zh-store", "1");
+        }
+    }
+
+    function installStorePatch() {
+        if (typeof window.showStoreAppsModal !== "function" || window.showStoreAppsModal.__zhStorePatched) return;
+
+        var originalShowStoreAppsModal = window.showStoreAppsModal;
+        window.showStoreAppsModal = function () {
+            var body = document.querySelector("#tableStoreAppsBody");
+            if (body && !body.__zhStoreObserver) {
+                var observer = new MutationObserver(function () {
+                    translateStoreRows();
+                });
+                observer.observe(body, { childList: true, subtree: true });
+                body.__zhStoreObserver = observer;
+            }
+
+            var result = originalShowStoreAppsModal.apply(this, arguments);
+            setTimeout(translateStoreRows, 0);
+            return result;
+        };
+        window.showStoreAppsModal.__zhStorePatched = true;
+    }
+
+    function translateInstalledAppRows() {
+        var rows = document.querySelectorAll("#tableAppsBody tr");
+        for (var i = 0; i < rows.length; i++) {
+            var row = rows[i];
+            if (row.getAttribute("data-zh-app") === "1") continue;
+
+            var nameSpan = row.querySelector('span[style*="font-weight: bold"]');
+            if (!nameSpan) continue;
+
+            var originalName = nameSpan.textContent.trim();
+            var item = APPS[originalName];
+            if (!item) continue;
+
+            nameSpan.textContent = item.name;
+
+            var descDivs = row.querySelectorAll('div[style*="margin-top: 10px"]');
+            if (descDivs.length > 0 && !descDivs[0].querySelector("a")) {
+                descDivs[0].innerHTML = escapeHtml(item.description).replace(/\n/g, "<br />");
+            }
+
+            row.setAttribute("data-zh-app", "1");
+        }
+    }
+
+    function installAppsPageObserver() {
+        var body = document.querySelector("#tableAppsBody");
+        if (!body || body.__zhAppObserver) return;
+
+        var observer = new MutationObserver(function () {
+            translateInstalledAppRows();
+        });
+        observer.observe(body, { childList: true, subtree: true });
+        body.__zhAppObserver = observer;
+        setTimeout(translateInstalledAppRows, 0);
+    }
+
+    installStorePatch();
+    installAppsPageObserver();
+})();
diff --git a/DnsServerCore/www/js/i18n-zh-help.js b/DnsServerCore/www/js/i18n-zh-help.js
new file mode 100644
index 0000000..18d444b
--- /dev/null
+++ b/DnsServerCore/www/js/i18n-zh-help.js
@@ -0,0 +1,741 @@
+/* Technitium DNS Server - Chinese help text dictionary (GPLv3) */
+window.TECH_ZH_HELP = {
+    "This option when enabled will always use the client's MAC address as the identifier to allocate lease instead of the Client Identifier (Option 61) provided by the client in the request. Some Linux distros use a custom Client Identifier instead of the device's MAC Address which can cause issues when the Virtual Machine (VM) in which the OS is installed is cloned causing both the original and cloned clients to get same IP allocated. There can be issues too when the same client changes its Client Identifier and starts getting a different IP address lease. Enabling the Ignore Client Identifier option will fix such issues. Changing this option may cause the existing clients to get a different IP lease on renewal.": "启用此选项后，将始终使用客户端的 MAC 地址作为分配租约的标识符，而不是客户端在请求中提供的客户端标识符（选项 61）。某些 Linux 发行版使用自定义客户端标识符而不是设备的 MAC 地址，这可能会在克隆安装操作系统的虚拟机 (VM) 时导致问题，导致原始客户端和克隆客户端分配相同的 IP。当同一客户端更改其客户端标识符并开始获取不同的 IP 地址租约时，也可能会出现问题。启用“忽略客户端标识符”选项将解决此类问题。更改此选项可能会导致现有客户端在续订时获得不同的 IP 租约。",
+    "If the Web Service does not have HTTPS enabled, then the initialization process will enable it automatically with a self-signed certificate. However, it is recommended to manually configure HTTPS with a valid certificate before initializing the Cluster. This certificate must include the new expected DNS Server Domain Name, as mentioned in the above note, as the Subject Common Name or Subject Alternative Name (SAN) so that it validates when a Secondary node tries to join the Cluster. Once a node joins the Cluster, it uses DANE-EE for server authentication and the domain name in the certificate is no longer required to match the DNS Server Domain Name.": "如果 Web 服务未启用 HTTPS，则初始化过程将使用自签名证书自动启用它。但是，建议在初始化集群之前使用有效证书手动配置 HTTPS。此证书必须包含新的预期 DNS 服务器域名（如上面注释中所述）作为主体公用名或主体备用名称 (SAN)，以便在辅助节点尝试加入集群时验证。一旦节点加入集群，它就会使用 DANE-EE 进行服务器身份验证，并且证书中的域名不再需要与 DNS 服务器域名相匹配。",
+    "Make sure that you have removed all of the DS records from the parent zone and sufficient time has passed before unsigning this zone. You MUST wait for at least the number of seconds specified by the DS record's TTL value to elapse before unsigning the zone to ensure that all recursive resolvers would have expired the DS records from its cache. For example, if you have DS records at the parent zone with TTL value set to 86400 then you must wait for 86400 seconds (24 hours) to pass after you delete the DS records from the parent zone. Once you have ensured that you have waited for the appropriate time then you can unsign the zone safely.": "确保您已从父区域中删除所有 DS 记录，并且在取消对该区域的签名之前已经过了足够的时间。在取消区域签名之前，您必须至少等待 DS 记录的 TTL 值指定的秒数过去，以确保所有递归解析器都已使缓存中的 DS 记录过期。例如，如果父区域中的 DS 记录的 TTL 值设置为 86400，则从父区域中删除 DS 记录后，必须等待 86400 秒（24 小时）过去。一旦您确保等待了适当的时间，您就可以安全地取消对该区域的签名。",
+    "Local addresses are the network interface IP addresses you want the Web Service to listen for requests. ANY addresses (0.0.0.0 & [::]) cannot be used together with unicast IP addresses. The web server uses dual-mode sockets by default so the IPv6 ANY address ([::]) works for IPv4 too. The default values work for most scenarios so, do not change these defaults unless you have a requirement for the Web Service to listen on specific networks. Configured unicast IP addresses will be included as Subject Alternative Name (SAN) in the self signed TLS certificate.": "本地地址是您希望 Web 服务侦听请求的网络接口 IP 地址。任何地址（0.0.0.0 和 [::]）不能与单播 IP 地址一起使用。 Web 服务器默认使用双模式套接字，因此 IPv6 ANY 地址 ([::]) 也适用于 IPv4。默认值适用于大多数情况，因此，除非您需要 Web 服务侦听特定网络，否则请勿更改这些默认值。配置的单播 IP 地址将作为主题备用名称 (SAN) 包含在自签名 TLS 证书中。",
+    "The maximum number of entries that the cache can store. A relevant value should be configured by monitoring the Cache entries value on Dashboard and the server's memory usage to limit the amount of RAM used by the DNS Server. A cache entry is a complete Resource Record Set (RR Set) which is a group of records with the same type for a given domain name. When a value is configured, the DNS Server will trigger a clean up operation every few minutes and remove least recently used entries to maintain the maximum allowed entries in cache.": "缓存可以存储的最大条目数。应通过监视仪表板上的缓存条目值和服务器的内存使用情况来配置相关值，以限制 DNS 服务器使用的 RAM 量。缓存条目是一个完整的资源记录集（RR Set），它是给定域名的一组具有相同类型的记录。配置值后，DNS 服务器将每隔几分钟触发一次清理操作，并删除最近最少使用的条目以维护缓存中允许的最大条目数。",
+    "Ping check would work as expected only when you make sure that all the client devices with manually configured IP addresses on the network respond to a ping request. Devices running Microsoft Windows by default drop ping requests at host firewall and will cause this ping check to fail to detect in use IP addresses. It is recommended to not rely on this option and instead make sure that you exclude a range of addresses using Exclusions and manually assign IP addresses to your devices only in the excluded range.": "仅当您确保网络上所有手动配置 IP 地址的客户端设备都响应 ping 请求时，Ping 检查才会按预期工作。默认情况下，运行 Microsoft Windows 的设备会在主机防火墙处丢弃 ping 请求，并导致此 ping 检查无法检测正在使用的 IP 地址。建议不要依赖此选项，而是确保使用排除排除一系列地址，并仅在排除的范围内手动将 IP 地址分配给您的设备。",
+    "When Group Map is configured, the LDAP user's group membership cannot be managed locally and any group membership changes must be configured at the directory service itself. LDAP users need to relogin so that any group membership changes made at the directory service are applied to their user accounts. The Group Map thus allows managing user access centrally via the directory service. Keep the Group Map empty if group membership management for LDAP users is required to be managed via the DNS Server itself.": "配置组映射后，无法在本地管理 LDAP 用户的组成员身份，并且必须在目录服务本身上配置任何组成员身份更改。 LDAP 用户需要重新登录，以便在目录服务中所做的任何组成员身份更改都应用到他们的用户帐户。因此，组映射允许通过目录服务集中管理用户访问。如果需要通过 DNS 服务器本身管理 LDAP 用户的组成员资格管理，请将组映射保留为空。",
+    "When Group Map is configured, the Single Sign-On (SSO) user's group membership cannot be managed locally and any group membership changes must be configured at the SSO provider itself. SSO users need to relogin so that any group membership changes made at SSO provider are applied to their user accounts. The Group Map thus allows managing user access centrally via the SSO provider. Keep the Group Map empty if group membership management for SSO users is required to be managed via the DNS Server itself.": "配置组映射后，单点登录 (SSO) 用户的组成员身份无法在本地进行管理，任何组成员身份更改都必须在 SSO 提供商本身进行配置。 SSO 用户需要重新登录，以便在 SSO 提供商处所做的任何组成员身份更改都会应用到他们的用户帐户。因此，组映射允许通过 SSO 提供商集中管理用户访问。如果需要通过 DNS 服务器本身管理 SSO 用户的组成员资格管理，请将组映射保留为空。",
+    "Queries Per Minute (QPM) feature will limit requests from a client subnet based on its IP address and the specified subnet prefix lengths except for loopback IP addresses. The QPM limit configured will be compared with the average count from the sample size which means a client may exceed the QPM limit for a given minute but won't exceed for the given sample size in minutes. Rate limited clients will be listed in orange color on the dashboard top clients table.": "每分钟查询数 (QPM) 功能将根据客户端子网的 IP 地址和指定的子网前缀长度限制来自客户端子网的请求（环回 IP 地址除外）。配置的 QPM 限制将与样本大小的平均计数进行比较，这意味着客户端可能会超出给定分钟内的 QPM 限制，但不会超出给定样本大小的分钟数。速率受限的客户将以橙色列在仪表板顶部客户表上。",
+    "Enable this option to allow querying two or more forwarders concurrently instead of sequentially querying them in their given order. The DNS Server will automatically select forwarders (based on their average latency) to query and use the fastest response it receives from any of them. If none of the selected forwarders respond in time, the DNS Server will similarly select forwarders from the remaining ones and queries them till all are tried before giving up.": "启用此选项可允许同时查询两个或多个转发器，而不是按给定顺序依次查询它们。 DNS 服务器将自动选择转发器（基于其平均延迟）来查询并使用从其中任何一个收到的最快响应。如果选定的转发器都没有及时响应，则 DNS 服务器将类似地从剩余的转发器中选择转发器并查询它们，直到尝试完所有转发器后才放弃。",
+    "If the Web Service does not have HTTPS enabled, then the joining process will enable it automatically with a self-signed certificate. However, its recommended to manually configure HTTPS with a valid certificate before joining the cluster. This certificate should optionally include the new expected DNS Server Domain Name, which will be a subdomain name of the Cluster Domain name, as the Subject Common Name or Subject Alternative Name (SAN).": "如果 Web 服务未启用 HTTPS，则加入过程将使用自签名证书自动启用它。但是，建议在加入集群之前使用有效证书手动配置 HTTPS。该证书应选择包含新的预期 DNS 服务器域名，该域名将是集群域名的子域名，作为主题公用名或主题备用名称 (SAN)。",
+    "The source adddresses configured above must be the IP addresses that are configured on the local system's network interface. When using source addresses option, its also necessary to ensure that the system has a default route or a specific route for the source address to be able to reach the destination network. When source addresses are not configured, the IP address of the interface with a default route will be used as the source address.": "上面配置的源地址必须是本地系统网络接口上配置的IP地址。当使用源地址选项时，还需要确保系统有一条默认路由或特定路由使源地址能够到达目的网络。当不配置源地址时，将使用有默认路由的接口的IP地址作为源地址。",
+    "Configuring a security policy above will cause the DNS Server to authenticate all dynamic update requests. A TSIG key can add/delete records only for the specified domain name and allowed record types. TSIG key names must be configured from the Settings before using them here. Use wildcard domain name to specify all sub domain names. Use a comma separator to specify more than one record type. Use ANY to specify all record types.": "配置上述安全策略将使 DNS 服务器对所有动态更新请求进行身份验证。 TSIG 密钥只能添加/删除指定域名和允许的记录类型的记录。 TSIG 键名称必须先在“设置”中进行配置，然后才能在此处使用。使用通配符域名指定所有子域名。使用逗号分隔符指定多个记录类型。使用 ANY 指定所有记录类型。",
+    "Enable IPv6 support only if this DNS Server has native IPv6 Internet access otherwise it will affect performance. There are many name servers on the Internet that do not respond over IPv6 and thus using Prefer IPv6 option when you are running DNS Server in recursive resolver mode (i.e. without any forwarders) may cause frequent operational issues with resolution that may result increase in Server Failure responses.": "仅当此 DNS 服务器具有本机 IPv6 Internet 访问权限时才启用 IPv6 支持，否则会影响性能。 Internet 上有许多名称服务器不通过 IPv6 进行响应，因此当您在递归解析器模式（即没有任何转发器）下运行 DNS 服务器时使用首选 IPv6 选项可能会导致频繁的解析操作问题，从而可能导致服务器故障响应增加。",
+    "The DNS Server supports EDNS and thus all outbound recursive resolution requests will have an OPT record for it in the additional section. If a name server does not respond to a request containing OPT record, the recursive resolver will retry again without the OPT record when possible. This means that the number of retries attempted per name server can be Resolver Retries value multiplied by two for certain cases.": "DNS 服务器支持 EDNS，因此所有出站递归解析请求都将在附加部分中具有 OPT 记录。如果名称服务器未响应包含 OPT 记录的请求，则递归解析器将在可能的情况下在没有 OPT 记录的情况下重试。这意味着在某些情况下，每个名称服务器尝试的重试次数可以是解析器重试值乘以 2。",
+    "The Web Service port changes will be automatically applied and so you do not need to manually restart the main service. The TLS certificate too will be automatically reloaded when the certificate file's date modified property on disk changes. This web page will be automatically redirected to the new web console URL after saving settings. The HTTPS protocol will be enabled only when a TLS certificate is configured.": "Web 服务端口更改将自动应用，因此您无需手动重新启动主服务。当磁盘上证书文件的日期修改属性发生更改时，TLS 证书也会自动重新加载。保存设置后，该网页将自动重定向到新的 Web 控制台 URL。仅当配置了 TLS 证书时才会启用 HTTPS 协议。",
+    "Devices that do not have a real-time clock and rely on NTP when booting (e.g. Raspberry Pi), enabling DNSSEC validation will cause failure to resolve the NTP server domain name thus causing the DNS Server to fail to validate all other domain names too due to invalid system date/time. To fix this issue, just create a Conditional Forwarder zone for the NTP server domain name (e.g. ntp.org) with forwarder set to": "对于没有实时时钟并在启动时依赖 NTP 的设备（例如 Raspberry Pi），启用 DNSSEC 验证将导致无法解析 NTP 服务器域名，从而导致 DNS 服务器由于系统日期/时间无效而无法验证所有其他域名。要解决此问题，只需为 NTP 服务器域名（例如 ntp.org）创建一个条件转发器区域，并将转发器设置为",
+    "Enabling UDP socket pool provides port randomization for all outbound DNS-over-UDP requests to mitigate spoofing attacks. It is recommended to enable UDP socket pool on Windows platform. On Linux, ports are fairly random and thus socket pool may be enabled if more randomization is desired. The DNS Server can detect DNS spoofing attack attempts based on ID mismatch and switch to TCP protocol automatically.": "启用 UDP 套接字池可为所有出站 DNS-over-UDP 请求提供端口随机化，以减轻欺骗攻击。建议在Windows平台上启用UDP套接字池。在 Linux 上，端口是相当随机的，因此如果需要更多随机化，可以启用套接字池。 DNS服务器可以根据ID不匹配检测DNS欺骗攻击尝试并自动切换到TCP协议。",
+    "The DNS Server loads all block lists in memory and thus it is expected that the server is provisioned with sufficient amount of memory to avoid out of memory issues. On average, 1 million domain names in block list take about 300 MB of memory. The block list update process requires additional memory to load the newly downloaded block lists before it replaces the previously loaded block lists in memory.": "DNS 服务器将所有拦截列表加载到内存中，因此期望为服务器配置足够的内存以避免内存不足问题。平均而言，拦截列表中的 100 万个域名大约需要 300 MB 的内存。块列表更新过程需要额外的内存来加载新下载的块列表，然后再替换内存中先前加载的块列表。",
+    "The promote To Primary node process will resync complete configuration from the Primary node and then proceed to delete it from the Cluster followed by upgrading the selected Secondary node to become the Primary node in the Cluster. The former Primary node when deleted will cause it to delete all its own Cluster configuration leaving the Cluster without causing any other data loss.": "升级到主节点过程将从主节点重新同步完整配置，然后继续将其从集群中删除，然后将选定的辅助节点升级为集群中的主节点。删除前主节点将导致其删除所有自己的集群配置，从而离开集群，而不会导致任何其他数据丢失。",
+    "EDNS Client Subnet (ECS) option allows passing the user's client subnet information to name servers or forwarders so that the response may contain IP addresses of servers closer to the user's geographic region. EDNS Client Subnet (ECS) option thus is only useful when the DNS Server is hosted in a geographically different region compared to the users that are configured to use it.": "EDNS 客户端子网 (ECS) 选项允许将用户的客户端子网信息传递到名称服务器或转发器，以便响应可以包含更接近用户地理区域的服务器的 IP 地址。因此，EDNS 客户端子网 (ECS) 选项仅当 DNS 服务器托管在与配置使用它的用户不同的地理区域中时才有用。",
+    "These optional DNS Server protocol changes will be automatically applied and so you do not need to manually restart the main service. The TLS certificate too will be automatically reloaded when the certificate file's date modified property on disk changes. The DNS-over-TLS, DNS-over-QUIC, and DNS-over-HTTPS protocols will be enabled only when a TLS certificate is configured.": "这些可选的 DNS 服务器协议更改将自动应用，因此您无需手动重新启动主服务。当磁盘上证书文件的日期修改属性发生更改时，TLS 证书也会自动重新加载。仅当配置了 TLS 证书时，才会启用 DNS-over-TLS、DNS-over-QUIC 和 DNS-over-HTTPS 协议。",
+    "You MUST wait for at least the number of seconds specified by the the old TTL value to elapse before making any changes to the DNS keys above to ensure that all recursive resolvers would have expired the DNSKEY records from its cache. For example, if the old TTL value was 3600, then you must wait for 3600 seconds (1 hour) to pass before making any changes to the DNS keys.": "在对上述 DNS 密钥进行任何更改之前，您必须至少等待旧 TTL 值指定的秒数过去，以确保所有递归解析器的缓存中的 DNSKEY 记录都已过期。例如，如果旧的 TTL 值为 3600，则您必须等待 3600 秒（1 小时）过去，然后才能对 DNS 密钥进行任何更改。",
+    "You can delete the Cluster only when there are no Secondary nodes in the Cluster. Use the Force Delete Cluster option only when you wish this Primary node to be removed from the Cluster even when there are Secondary nodes in the Cluster. In this case, the Secondary nodes will become orphaned and you will need to promote one of them to be the new Primary node manually.": "仅当Cluster中没有Secondary节点时才可以删除Cluster。仅当您希望从集群中删除该主节点（即使集群中存在辅助节点）时，才使用“强制删除集群”选项。在这种情况下，辅助节点将成为孤立节点，您需要手动将其中一个节点提升为新的主节点。",
+    "The TTL value in seconds which should be used to reset the stale record's TTL value in the cache when the resolver fails to refresh the data. The TTL reset causes the stale records to become valid again so that they can be used to serve requests normally. This reset effectively prevents the resolver from attempting to frequently update the stale records.": "TTL 值（以秒为单位），当解析器刷新数据失败时，应使用该值重置缓存中过时记录的 TTL 值。 TTL 重置会使过时的记录再次有效，以便它们可以正常用于服务请求。此重置有效地防止解析器尝试频繁更新过时的记录。",
+    "Map Remote Groups at Single Sign-On (SSO) provider to Local Groups for both new and existing users signed up via Single Sign-On (SSO). A SSO user's group membership will be automatically synced to the mapped Local Groups each time they log in. If your SSO provider does not include group membership claim by default then you will have to add": "对于通过单点登录 (SSO) 注册的新用户和现有用户，将单点登录 (SSO) 提供商处的远程组映射到本地组。 SSO 用户的组成员身份将在每次登录时自动同步到映射的本地组。如果您的 SSO 提供商默认情况下不包含组成员身份声明，则您必须添加",
+    "The time in milliseconds that the DNS Server must wait for the resolver before serving stale records from the cache. Lower value will ensure faster response at the expense of not getting updated data from the upstream. Setting value to 0 will instantly return stale answer without waiting for the resolver to fetch updates from the upstream.": "DNS 服务器在从缓存提供陈旧记录之前必须等待解析器的时间（以毫秒为单位）。较低的值将确保更快的响应，但代价是无法从上游获取更新的数据。将值设置为 0 将立即返回过时的答案，而无需等待解析器从上游获取更新。",
+    "The conversion process may take a while depending on the number of records the zone has. When converting a Secondary Catalog zone to a Catalog zone, all member zones too will be converted to either Primary or Conditional Forwarder zone depending on their existing zone type. Please be patient till the conversion process completes.": "转换过程可能需要一段时间，具体取决于区域拥有的记录数量。将辅助目录区域转换为目录区域时，所有成员区域也将转换为主要区域或条件转发器区域，具体取决于其现有区域类型。请耐心等待，直到转换过程完成。",
+    "The Ignore Certificate Validation Errors option when selected is used only for the initial connection to the Primary node during the joining process. Once the DNS Server joins the Cluster, it will always use DANE-EE for authentication using the TLSA records in the Cluster Primary zone that are added for each node in the Cluster.": "选择“忽略证书验证错误”选项后，该选项仅用于加入过程中与主节点的初始连接。一旦 DNS 服务器加入集群，它将始终使用 DANE-EE 进行身份验证，并使用为集群中每个节点添加的集群主区域中的 TLSA 记录。",
+    "The token allows access to API calls with the same privileges as that of the user account. Thus its recommended to create a separate user account with limited permissions as required by the specific task that the token will be used for. The token cannot be used to change the user's password, or update the user profile details.": "该令牌允许使用与用户帐户相同的权限访问 API 调用。因此，建议根据令牌将用于的特定任务的需要创建具有有限权限的单独用户帐户。该令牌不能用于更改用户的密码或更新用户个人资料详细信息。",
+    "The DNS Server uses Epsilon-Greedy machine learning algorithm and will automatically learn which of the name servers are answering faster without errors and will use those name servers most of the time. Since each domain name has a different set of name servers, it may take a while before the algorithm learns about them.": "DNS 服务器使用 Epsilon-Greedy 机器学习算法，将自动了解哪些名称服务器响应速度更快且不会出现错误，并将在大部分时间使用这些名称服务器。由于每个域名都有一组不同的名称服务器，因此算法可能需要一段时间才能了解它们。",
+    "option may cause some domain names to fail to resolve due to their name servers dropping the requests or sending the QNAME in response with a different case causing mismatch. The DNS Server can already detect DNS spoofing attack attempts and switch to TCP protocol automatically so its safe to not use this feature.": "选项可能会导致某些域名无法解析，因为它们的名称服务器会丢弃请求或发送 QNAME 来响应不同的情况，从而导致不匹配。 DNS 服务器已经可以检测 DNS 欺骗攻击尝试并自动切换到 TCP 协议，因此不使用此功能是安全的。",
+    "The Web Service uses Kestrel web server which supports both HTTP/2 and HTTP/3 protocols when TLS certificate is configured. HTTP/3 protocol support is not available on all platforms. On Windows, it is available only on Windows 11 (build 22000 and later) and Windows Server 2022 (and later). On Linux, it requires": "Web 服务使用 Kestrel Web 服务器，在配置 TLS 证书时，该服务器支持 HTTP/2 和 HTTP/3 协议。 HTTP/3 协议支持并非在所有平台上都可用。在 Windows 上，它仅在 Windows 11（内部版本 22000 及更高版本）和 Windows Server 2022（及更高版本）上可用。在Linux上，它需要",
+    "The initialization process will create two zones if they do not exist. The first zone will be the Cluster Primary zone named as the Cluster Domain name specified above where the Cluster will automatically manage domain name records for all the nodes. The second zone will be the Cluster Catalog zone that uses": "如果两个区域不存在，初始化过程将创建它们。第一个区域将是集群主区域，命名为上面指定的集群域名，集群将自动管理所有节点的域名记录。第二个区域将是集群目录区域，它使用",
+    "EDNS Client Subnet (ECS) option when enabled will compromises user's privacy since the DNS Server will send the user's public IP network subnet to name servers or forwarders when resolving requests. When not using encrypted DNS protocols, this information can also be read passively by anyone on the network.": "EDNS 客户端子网 (ECS) 选项启用后会损害用户的隐私，因为 DNS 服务器在解析请求时会将用户的公共 IP 网络子网发送到名称服务器或转发器。当不使用加密的 DNS 协议时，网络上的任何人也可以被动读取此信息。",
+    "Enabling EDNS Client Subnet (ECS) option will significantly increase the DNS Server's memory usage since the server will have to cache data for each client subnet separately. It will also increase cache misses since DNS Server will have to resolve requests and cache them for each client subnet separately.": "启用 EDNS 客户端子网 (ECS) 选项将显着增加 DNS 服务器的内存使用量，因为服务器必须单独缓存每个客户端子网的数据。它还会增加缓存未命中的情况，因为 DNS 服务器必须分别为每个客户端子网解析请求并缓存它们。",
+    "Enable this option to read the client's source IP address from the EDNS Client Subnet (ECS) option in the DNS requests coming via DNS-over-UDP or DNS-over-TCP protocols. This option allows a DNS proxy to pass the client's source IP address via ECS option to the DNS Server. It is mandatory to configure": "启用此选项可从通过 DNS-over-UDP 或 DNS-over-TCP 协议传入的 DNS 请求中的 EDNS 客户端子网 (ECS) 选项读取客户端的源 IP 地址。此选项允许 DNS 代理通过 ECS 选项将客户端的源 IP 地址传递到 DNS 服务器。必须要配置",
+    "When a Single Sign-On (SSO) user signs up with the DNS Server, an account for the user is created which uses the email address as the username. If email address is not available, the preferred username is used instead. If you do not wish to use email address as the username, you can remove the": "当单点登录 (SSO) 用户在 DNS 服务器上注册时，系统会为该用户创建一个帐户，该帐户使用电子邮件地址作为用户名。如果电子邮件地址不可用，则会使用首选用户名。如果您不想使用电子邮件地址作为用户名，您可以删除",
+    "Joining a Cluster will make this DNS Server its Secondary node. This process will overwrite configuration on this DNS Server for Allowed, Blocked, Apps, Settings and Administration sections. The DNS Server will automatically synchronize its configuration with the Primary node in the Cluster.": "加入集群将使该 DNS 服务器成为辅助节点。此过程将覆盖此 DNS 服务器上允许、拦截、应用程序、设置和管理部分的配置。 DNS Server 会自动将其配置与集群中的主节点同步。",
+    "TSIG key names must be configured from the Settings before using them here. Entering one or more TSIG key names above will cause the DNS Server to authenticate all zone transfer requests. A secondary zone must be configured with one of the above keys to be able to perform a zone transfer.": "TSIG 键名称必须先在“设置”中进行配置，然后才能在此处使用。输入上面的一个或多个 TSIG 密钥名称将使 DNS 服务器对所有区域传输请求进行身份验证。辅助区域必须配置上述密钥之一才能执行区域传输。",
+    "You need to have the above recursion option enabled even when you have configured Forwarders in Settings and do not want the DNS Server to do recursive resolution. This option is not about recursive resolution itself but about the Recursion Desired (RD) flag in the incoming DNS requests.": "即使您在“设置”中配置了转发器并且不希望 DNS 服务器进行递归解析，您也需要启用上述递归选项。此选项与递归解析本身无关，而是与传入 DNS 请求中的递归所需 (RD) 标志有关。",
+    "The Leave Cluster process will remove all Cluster configuration from this Secondary node and leave the Cluster gracefully. There will be no data loss except for the Cluster configuration. You will need to re-join the Cluster again to use this DNS Server as a Secondary node.": "离开集群过程将从该辅助节点中删除所有集群配置并正常离开集群。除了集群配置之外，不会有任何数据丢失。您需要再次重新加入集群才能将此 DNS 服务器用作辅助节点。",
+    "When using docker image without \"host\" network mode, any changes to Web Service Local Addresses and Web Service HTTP/HTTPS Port options must be done only at docker level using docker compose file. Changing these options in Settings will make the Web Service inaccessible.": "当使用不带“主机”网络模式的 docker 映像时，对 Web 服务本地地址和 Web 服务 HTTP/HTTPS 端口选项的任何更改必须仅在 docker 级别使用 docker compose 文件完成。更改“设置”中的这些选项将导致 Web 服务无法访问。",
+    "To reset 'admin' password, you will need file system access on the server running this DNS Server. If the 'admin' user does not exists then it will be created automatically. If the 'admin' user has Two-factor Authentication (2FA) configured then it will be disabled too.": "要重置“admin”密码，您需要访问运行此 DNS 服务器的服务器上的文件系统。如果“admin”用户不存在，则会自动创建。如果“管理员”用户配置了双因素身份验证 (2FA)，那么它也将被禁用。",
+    "The DNS Server will attempt to save cache to disk when it stops which may take time depending on the cache size. If the DNS Server takes a lot of time to stop then it may lead to the OS killing the DNS Server process causing an incomplete cache to be stored on disk.": "DNS 服务器在停止时将尝试将缓存保存到磁盘，这可能需要一些时间，具体取决于缓存大小。如果 DNS 服务器需要很长时间才能停止，则可能会导致操作系统终止 DNS 服务器进程，从而导致磁盘上存储不完整的缓存。",
+    "The Vendor Specific Information (option 43) to be sent to the clients that match the Vendor Class Identifier (option 60) in the request. The Vendor Class Identifier can be empty string to match any identifier, or matched exactly, or match a substring, for example": "要发送到与请求中的供应商类标识符（选项 60）匹配的客户端的供应商特定信息（选项 43）。供应商类标识符可以是空字符串以匹配任何标识符，或者完全匹配，或者匹配子字符串，例如",
+    "The percentage of requests that are responded with a truncation (TC) response when QPM limit exceeds for DNS-over-UDP protocol service while the rest of the requests are dropped. A TC response will cause a real client to retry to DNS-over-TCP protocol service.": "当超出 DNS-over-UDP 协议服务的 QPM 限制而其余请求被丢弃时，以截断 (TC) 响应进行响应的请求的百分比。 TC 响应将导致真实客户端重试 DNS-over-TCP 协议服务。",
+    "Any DNS related failure may cause LDAP authentication to fail to work making it impossible for LDAP users to log in to fix the DNS issue due to circular dependency. Thus, it is recommended to maintain a local administrator user account for such scenarios.": "任何与 DNS 相关的故障都可能导致 LDAP 身份验证无法工作，从而导致 LDAP 用户无法登录以修复由于循环依赖而导致的 DNS 问题。因此，建议针对此类情况维护本地管理员用户帐户。",
+    "Any DNS related failure may cause Single Sign-On (SSO) to fail to work making it impossible for SSO users to log in to fix the DNS issue due to circular dependency. Thus, it is recommended to maintain a local administrator user account for such scenarios.": "任何与 DNS 相关的故障都可能导致单点登录 (SSO) 无法工作，从而导致 SSO 用户由于循环依赖而无法登录来修复 DNS 问题。因此，建议针对此类情况维护本地管理员用户帐户。",
+    "The Cluster Domain name cannot be changed later. Make sure that you enter the correct domain name before proceeding. You can update the DNS Server Domain Name later if needed from Settings but it must always be a subdomain name of the Cluster Domain name.": "集群域名以后无法更改。在继续之前，请确保输入正确的域名。如果需要，您可以稍后从“设置”中更新 DNS 服务器域名，但它必须始终是集群域名的子域名。",
+    "The number of iterations used by NSEC3 for hashing the domain names. It is recommended to use 0 iterations since more iterations will increase computational costs for both the DNS Server and resolver while not providing much value against \"zone walking\" [": "NSEC3 用于对域名进行哈希处理的迭代次数。建议使用 0 次迭代，因为更多迭代会增加 DNS 服务器和解析器的计算成本，同时不会为“区域行走”提供太多价值 [",
+    "The Delete Cluster process will remove all Cluster configuration from this Primary node. There will be no data loss except for the Cluster configuration. You will need to re-initialize the Cluster again to use clustering features on this DNS Server.": "删除集群过程将从该主节点中删除所有集群配置。除了集群配置之外，不会有任何数据丢失。您需要再次重新初始化集群才能使用此 DNS 服务器上的集群功能。",
+    "The TTL value in seconds which should be used for cached records that are expired. When the serve stale TTL too expires for a stale record, it gets removed from the cache. Recommended value is between 1-3 days and maximum supported value is 7 days.": "用于过期缓存记录的 TTL 值（以秒为单位）。当陈旧记录的服务陈旧 TTL 也过期时，它就会从缓存中删除。建议值介于 1-3 天之间，支持的最大值为 7 天。",
+    "Enable this option to refresh records that are about to expire in cache. A prefetch background task for a cached record is triggered when it is queried for and the DNS server finds the record's TTL value to be less than the Prefetch Trigger value.": "启用此选项可刷新缓存中即将过期的记录。当查询缓存记录并且 DNS 服务器发现记录的 TTL 值小于预取触发值时，将触发缓存记录的预取后台任务。",
+    "This feature allows you to define DHCP options that are not yet directly supported. To add an option, use the DHCP option code defined for it and enter the value in either a colon (:) separated hex string or a normal hex string format, for example": "此功能允许您定义尚未直接支持的 DHCP 选项。要添加选项，请使用为其定义的 DHCP 选项代码，并以冒号 (:) 分隔的十六进制字符串或正常的十六进制字符串格式输入值，例如",
